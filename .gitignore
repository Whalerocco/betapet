# Dependencies
node_modules/

# Next.js
.next/
out/

# Build output
dist/
build/

# Environment variables. The `*.env` line is the catch-all: the three rules above only match
# files *starting* with `.env`, so a `prod.env` written by `vercel env pull --environment=production`
# was not ignored — and that file carries a live VERCEL_OIDC_TOKEN even when the secrets
# themselves come back as placeholders.
.env
.env.local
.env.*.local
*.env

# Testing
coverage/
playwright-report/
test-results/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor/OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Raw dictionary source data (hundreds of MB; regenerate via scripts/preprocess-dictionary.ts)
scripts/dictionary-raw-sources/*
!scripts/dictionary-raw-sources/README.md
# Vercel CLI project link and its OIDC token (the .env rules above already cover .env.local).
.vercel
